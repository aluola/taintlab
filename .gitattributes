# Frozen experiment inputs must keep their exact bytes on Windows checkout.
*.py text eol=lf
configs/*.json text eol=lf
data/*.jsonl -text
data/*.json -text
data/v2/** -text
# These release inputs/metadata are bound by exact-byte hashes.
frontend/** -text
configs/experiment_v2.lock.json -text
demo/** -text
docs/project_report.md -text
docs/v2/qa/** -text
docs/qa/*.json -text
docs/qa/visual_review.md -text

# Public docs and evidence hashes must survive Windows checkout unchanged.
README.md text eol=lf
AGENTS.md text eol=lf
docs/LIGHT_PACKAGE.md text eol=lf
scripts/*.cjs text eol=lf
scripts/install.ps1 text eol=lf
docs/USER_MANUAL.* -text
docs/assets/user-manual/** -text
docs/publication/** -text

# v2.0.1 documentation, screenshots and independent evidence are hash-bound.
docs/CORE_FEATURES_GUIDE.* -text
docs/DEVELOPMENT_AND_DELIVERY.* -text
docs/FEATURE_EVIDENCE_MATRIX.md -text
docs/assets/core-features/** -text
docs/assets/development-delivery/** -text
docs/core_features_qa/** -text
docs/development_delivery_qa/** -text
data/demo/core_features/** -text
results/core_features/** -text

# Publication snapshot: preserve all manifest-bound bytes
* -text
